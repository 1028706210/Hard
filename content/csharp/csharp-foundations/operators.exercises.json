    {
      "id": "csharp-foundations-operators-c01",
      "type": "code",
      "prompt": "依次读取整数 a 和非零整数 b，按顺序输出 a+b、a-b、a*b、a/b、a%b，五个结果以单个空格分隔。",
      "starter_code": "var a = int.Parse(Console.ReadLine() ?? \"\");\nvar b = int.Parse(Console.ReadLine() ?? \"\");\n// 使用五种算术运算符并输出\n",
      "visible_tests": [
        "输入 17 和 5 时输出 22 12 85 3 2。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "var a = int.Parse(Console.ReadLine() ?? \"\");\nvar b = int.Parse(Console.ReadLine() ?? \"\");\nConsole.WriteLine($\"{a + b} {a - b} {a * b} {a / b} {a % b}\");\n",
        "hidden_tests": [
          "不能整除的正整数保留商与余数语义。",
          "负被除数遵循 C# 整数除法与取余规则。"
        ],
        "visible_test_cases": [
          {
            "stdin": "17\n5\n",
            "stdout": "22 12 85 3 2\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
