    {
      "id": "csharp-foundations-introduction-c01",
      "type": "code",
      "prompt": "读取一个 .NET 主版本号 n，输出 C# -> .NET n，用一行结果表达 C# 语言与 .NET 平台的关系。",
      "starter_code": "var major = int.Parse(Console.ReadLine() ?? \"\");\n// 输出语言与平台关系\n",
      "visible_tests": [
        "输入 8 时输出 C# -> .NET 8。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "var major = int.Parse(Console.ReadLine() ?? \"\");\nConsole.WriteLine($\"C# -> .NET {major}\");\n",
        "hidden_tests": [
          "输入 6 时保留对应平台版本。",
          "输入 9 时保留对应平台版本。"
        ],
        "visible_test_cases": [
          {
            "stdin": "8\n",
            "stdout": "C# -> .NET 8\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "6\n",
            "stdout": "C# -> .NET 6\n",
            "exit_code": 0
          },
          {
            "stdin": "9\n",
            "stdout": "C# -> .NET 9\n",
            "exit_code": 0
          }
        ]
      }
