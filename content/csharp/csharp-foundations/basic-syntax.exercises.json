    {
      "id": "csharp-foundations-basic-syntax-c01",
      "type": "code",
      "prompt": "读取整数 count，使用标识符 language、marker 和 count 保存字符串字面量 \"C#\"、字符字面量 '#' 与输入值，输出 C#:#count。",
      "starter_code": "var count = int.Parse(Console.ReadLine() ?? \"\");\n// 声明 language 与 marker，并按格式输出\n",
      "visible_tests": [
        "输入 3 时输出 C#:#3。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "var count = int.Parse(Console.ReadLine() ?? \"\");\nvar language = \"C#\";\nvar marker = '#';\nConsole.WriteLine($\"{language}:{marker}{count}\");\n",
        "hidden_tests": [
          "零值保持数字字面含义。",
          "多位整数完整输出。"
        ],
        "visible_test_cases": [
          {
            "stdin": "3\n",
            "stdout": "C#:#3\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "0\n",
            "stdout": "C#:#0\n",
            "exit_code": 0
          },
          {
            "stdin": "12\n",
            "stdout": "C#:#12\n",
            "exit_code": 0
          }
        ]
      }
    }
