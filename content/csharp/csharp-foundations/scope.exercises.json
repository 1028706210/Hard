    {
      "id": "csharp-foundations-scope-c01",
      "type": "code",
      "prompt": "依次读取三个整数。用外层 total 保存总和，并在三个相邻代码块中重复声明块内变量 value、把它加入 total，最后输出 total。",
      "starter_code": "var total = 0;\n// 建立三个相邻代码块，每块读取自己的 value 并累计\n\nConsole.WriteLine(total);\n",
      "visible_tests": [
        "输入 2、3、4 时输出 9。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "var total = 0;\n{\n    var value = int.Parse(Console.ReadLine() ?? \"\");\n    total += value;\n}\n{\n    var value = int.Parse(Console.ReadLine() ?? \"\");\n    total += value;\n}\n{\n    var value = int.Parse(Console.ReadLine() ?? \"\");\n    total += value;\n}\nConsole.WriteLine(total);\n",
        "hidden_tests": [
          "负数仍由块内临时变量累计。",
          "三个零的总和为零。"
        ],
        "visible_test_cases": [
          {
            "stdin": "2\n3\n4\n",
            "stdout": "9\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "-2\n5\n-1\n",
            "stdout": "2\n",
            "exit_code": 0
          },
          {
            "stdin": "0\n0\n0\n",
            "stdout": "0\n",
            "exit_code": 0
          }
        ]
      }
    }
  ]
