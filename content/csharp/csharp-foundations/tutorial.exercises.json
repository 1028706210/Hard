      "id": "csharp-foundations-tutorial-c01",
      "type": "code",
      "prompt": "读取一行文本，先去除首尾空白，再输出其不区分区域性的全大写形式；规范化后为空时输出 empty。",
      "starter_code": "var value = Console.ReadLine() ?? \"\";\n// 规范化输入并输出结果\n",
      "visible_tests": [
        "输入 hard 时输出 HARD。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "var value = Console.ReadLine() ?? \"\";\nvalue = value.Trim();\nConsole.WriteLine(value.Length == 0 ? \"empty\" : value.ToUpperInvariant());\n",
        "hidden_tests": [
          "空行输出 empty。",
          "混合大小写且带首尾空白时输出规范化结果。"
        ],
        "visible_test_cases": [
          {
            "stdin": "hard\n",
            "stdout": "HARD\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "\n",
            "stdout": "empty\n",
            "exit_code": 0
          },
          {
            "stdin": "  CsHaRp  \n",
            "stdout": "CSHARP\n",
            "exit_code": 0
          }
