      "prompt": "执行 `int? x = null; Console.WriteLine(x.Value);` 的结果是？",
      "choices": [
        {
          "id": "a",
          "text": "输出 0"
        },
        {
          "id": "b",
          "text": "抛出 InvalidOperationException"
