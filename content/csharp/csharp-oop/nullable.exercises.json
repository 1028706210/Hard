      "id": "csharp-oop-nullable-k01",
      "type": "knowledge",
      "prompt": "`int?` 在运行时的本质是什么？",
      "choices": [
        {
          "id": "a",
          "text": "Nullable<int>：一个可以包含 null 的值类型"
        },
        {
          "id": "b",
          "text": "一种新的引用类型"
        },
        {
          "id": "c",
          "text": "int 的别名，行为完全相同"
        }
      ],
      "experience_points": 5,
      "private": {
        "reference_answer": "a"
      }
    },
    {
      "id": "csharp-oop-nullable-k02",
      "type": "knowledge",
      "prompt": "启用可空引用类型后，`string?` 表达的含义是？",
      "choices": [
        {
