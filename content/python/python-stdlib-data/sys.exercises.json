      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    required = int(text)\nexcept ValueError:\n    raise SystemExit(1)\nif not 1 <= required <= 99:\n    raise SystemExit(1)\nprint(sys.version_info.major >= required)\n",
