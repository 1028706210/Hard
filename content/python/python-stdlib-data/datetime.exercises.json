    {
      "id": "python-stdlib-data-datetime-c01",
      "type": "code",
      "prompt": "输入以空白分隔的严格 YYYY-MM-DD 日期和整数天数 days（-365 到 365，含端点）。使用 timedelta 加上天数，输出完整 ISO 日期。允许负数与零，跨月跨年及闰日由日期运算处理。格式错误、越界或运算超出年份 1 到 9999 时不输出内容，退出码 1。起始代码提供 start、days；请捕获运算时的 OverflowError。",
      "starter_code": "import sys\ntext = sys.stdin.read().strip()\nimport re\nfrom datetime import date, timedelta\ntry:\n    raw_date, raw_days = text.split()\n    if re.fullmatch(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}\", raw_date) is None:\n        raise ValueError\n    start = date.fromisoformat(raw_date)\n    days = int(raw_days)\n    if not -365 <= days <= 365:\n        raise ValueError\nexcept ValueError:\n    raise SystemExit(1)\n# 完成本课操作与输出\n",
      "visible_tests": [
        "输入 '2026-01-01 1'，输出 '2026-01-02\\n'，退出码 0。",
        "输入 '2026-12-31 1'，输出 '2027-01-01\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\nimport re\nfrom datetime import date, timedelta\ntry:\n    raw_date, raw_days = text.split()\n    if re.fullmatch(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}\", raw_date) is None:\n        raise ValueError\n    start = date.fromisoformat(raw_date)\n    days = int(raw_days)\n    if not -365 <= days <= 365:\n        raise ValueError\nexcept ValueError:\n    raise SystemExit(1)\ntry:\n    result = start + timedelta(days=days)\nexcept OverflowError:\n    raise SystemExit(1)\nprint(result.isoformat())\n",
        "hidden_tests": [
          "核对题面声明的正常边界。",
          "输入、输出和退出状态必须符合题面。"
        ],
