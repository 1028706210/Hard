      "id": "python-stdlib-data-regex-basics-c01",
      "type": "code",
      "prompt": "读取全部文本，仅删除末尾换行符 \\n。用 [0-9]+ 和 fullmatch 验证是否恰好为一个或多个 ASCII 数字字符，输出 True 或 False。保留前导零；负号、小数点、空格、Unicode 数字与空文本都是 False，退出码 0。",
      "starter_code": "import sys\ntext = sys.stdin.read().rstrip(\"\\n\")\nimport re\n# 完成本课操作与输出\n",
      "visible_tests": [
        "输入 '42'，输出 'True\\n'，退出码 0。",
        "输入 '4a'，输出 'False\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().rstrip(\"\\n\")\nimport re\nprint(bool(re.fullmatch(r\"[0-9]+\", text)))\n",
