      "id": "python-stdlib-data-stringio-c01",
      "type": "code",
      "prompt": "读取全部文本，仅删除末尾所有换行符 \\n，保留空格及内部换行。创建空 StringIO，写入 text，再将游标移到开头并读取全部内容，用 print 输出。空文本输出一个换行。所有文本均有效，不读写磁盘。起始代码已读取 text 并导入 StringIO。",
      "starter_code": "import sys\ntext = sys.stdin.read().rstrip(\"\\n\")\nfrom io import StringIO\n# 完成本课操作与输出\n",
      "visible_tests": [
        "输入 'ready\\n'，输出 'ready\\n'，退出码 0。",
        "输入 '学习\\n'，输出 '学习\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().rstrip(\"\\n\")\nfrom io import StringIO\nstream = StringIO()\nstream.write(text)\nstream.seek(0)\nprint(stream.read())\n",
        "hidden_tests": [
          "核对题面声明的正常边界。",
          "输入、输出和退出状态必须符合题面。"
        ],
