    {
      "id": "python-stdlib-data-date-time-c01",
      "type": "code",
      "prompt": "读取严格格式 YYYY-MM-DD 的日期，使用 date.fromisoformat 解析，再输出 isoformat()。年份为四位，月份和日期各两位；必须是真实存在且年份在 1 到 9999 的日期。去掉首尾空白，闰日按公历规则验证。不符合格式、日期不存在或空输入时不输出内容，退出码 1。起始代码已解析 value。",
      "starter_code": "import sys\ntext = sys.stdin.read().strip()\nimport re\nfrom datetime import date\nif re.fullmatch(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}\", text) is None:\n    raise SystemExit(1)\ntry:\n    value = date.fromisoformat(text)\nexcept ValueError:\n    raise SystemExit(1)\n# 完成本课操作与输出\n",
      "visible_tests": [
        "输入 '2026-08-23'，输出 '2026-08-23\\n'，退出码 0。",
        "输入 '2024-02-29'，输出 '2024-02-29\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\nimport re\nfrom datetime import date\nif re.fullmatch(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}\", text) is None:\n    raise SystemExit(1)\ntry:\n    value = date.fromisoformat(text)\nexcept ValueError:\n    raise SystemExit(1)\nprint(value.isoformat())\n",
        "hidden_tests": [
