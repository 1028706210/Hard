    {
      "id": "python-stdlib-data-math-c01",
      "type": "code",
      "prompt": "读取一个 0 到 1000000（含端点）的整数 n，调用 math.sqrt 并以固定三位小数输出结果，例如 9 输出 3.000，2 输出 1.414。使用格式 f\"{结果:.3f}\"。负数、越界、非整数或空输入不输出内容，退出码为 1。起始代码已校验 n。",
      "starter_code": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    n = int(text)\nexcept ValueError:\n    raise SystemExit(1)\nif not 0 <= n <= 1000000:\n    raise SystemExit(1)\n# 按题面完成计算与输出\n",
      "visible_tests": [
        "输入 '9'，输出 '3.000\\n'，退出码 0。",
        "输入 '2'，输出 '1.414\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    n = int(text)\nexcept ValueError:\n    raise SystemExit(1)\nif not 0 <= n <= 1000000:\n    raise SystemExit(1)\nimport math\nprint(f\"{math.sqrt(n):.3f}\")\n",
        "hidden_tests": [
          "检查题面声明的正常输入和边界。",
          "输入有效性及输出格式以题面为准。"
        ],
