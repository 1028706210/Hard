      "id": "python-stdlib-data-queue-c01",
      "type": "code",
      "prompt": "读取以空白分隔的任务名，按原顺序全部放入 queue.Queue，再逐个取出并逐行输出。保留重复项，中文有效；空队列不输出内容并正常结束。本题单线程，不启动后台任务。起始代码提供 names 和 Queue。",
      "starter_code": "import sys\nfrom queue import Queue\nnames = sys.stdin.read().split()\n# 完成本课操作与输出\n",
      "visible_tests": [
        "输入 'a b'，输出 'a\\nb\\n'，退出码 0。",
        "输入 'task'，输出 'task\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\nfrom queue import Queue\nnames = sys.stdin.read().split()\nitems = Queue()\nfor name in names:\n    items.put(name)\nwhile not items.empty():\n    print(items.get_nowait())\n",
        "hidden_tests": [
          "核对题面声明的正常边界。",
          "输入、输出和退出状态必须符合题面。"
        ],
        "visible_test_cases": [
