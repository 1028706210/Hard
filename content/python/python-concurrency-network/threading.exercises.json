      "prompt": "使用 threading.Lock 保护计数器；输入为线程数，零是边界，负数拒绝。",
      "starter_code": "import threading\nimport sys\n# 使用 Lock 保护共享计数器\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\nimport threading\ncount = int(sys.stdin.read().strip())\nif count < 0 or count > 8:\n    raise ValueError('count out of range')\nstate = {'value': 0}\nlock = threading.Lock()\ndef increment():\n    with lock:\n        state['value'] += 1\nthreads = [threading.Thread(target=increment) for _ in range(count)]\nfor thread in threads: thread.start()\nfor thread in threads: thread.join()\nprint(state['value'])\n",
        "hidden_tests": [
          "边界输入必须返回主题定义的结果。",
