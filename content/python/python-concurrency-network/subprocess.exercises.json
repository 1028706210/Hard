      "prompt": "用纯函数验证结构化命令白名单，不启动子进程或 shell。",
      "starter_code": "import sys\n# 只检查结构化命令计划，不调用 subprocess\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\nparts = [part for part in sys.stdin.read().strip().split(' ') if part]\nif parts == ['__invalid__'] or not parts:\n    raise ValueError('command required')\nallowed = {'python': {'--version', '-V'}}\nname, *arguments = parts\nif name not in allowed or any(argument not in allowed[name] for argument in arguments):\n    print('rejected')\nelse:\n    print('allowed')\n",
        "hidden_tests": [
          "边界输入必须返回主题定义的结果。",
          "无效输入必须进入可预期的失败分支。"
        ],
        "visible_test_cases": [
          {
            "stdin": "python --version\n",
            "stdout": "allowed\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "python --bad\n",
            "stdout": "rejected\n",
            "exit_code": 0
          },
          {
            "stdin": "__invalid__\n",
