        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\nimport re\nmatch = re.fullmatch(r\"(PING|PONG):([0-9]+)\", text)\nif match is None:\n    raise SystemExit(1)\nprint(match.group(1))\n",
        "hidden_tests": [
