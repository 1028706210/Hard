      "type": "code",
      "prompt": "读取 JSON 对象，要求 to 是非空字符串，body 是字符串（允许空）。输出 body 原文，print 添加换行；允许额外字段。格式或字段类型不合法时无输出，退出码 1。这里只读取消息 fixture，不验证邮箱规范，也不发送邮件。支架已经提供 data。",
      "starter_code": "import sys, json\ntry:\n    data = json.loads(sys.stdin.read())\nexcept ValueError:\n    raise SystemExit(1)\nif not isinstance(data, dict):\n    raise SystemExit(1)\nif not isinstance(data.get(\"to\"), str) or not data[\"to\"].strip() or not isinstance(data.get(\"body\"), str):\n    raise SystemExit(1)\n# 按题面实现本课操作\n",
      "visible_tests": [
        "输入 '{\"to\":\"a@example.test\",\"body\":\"ready\"}'，输出 'ready\\n'，退出码 0。",
