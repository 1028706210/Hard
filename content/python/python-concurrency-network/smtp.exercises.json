      "experience_points": 15,
      "private": {
        "reference_solution": "import sys, json\ntry:\n    data = json.loads(sys.stdin.read())\nexcept ValueError:\n    raise SystemExit(1)\nif not isinstance(data, dict):\n    raise SystemExit(1)\nif not isinstance(data.get(\"to\"), str) or not data[\"to\"].strip() or not isinstance(data.get(\"body\"), str):\n    raise SystemExit(1)\nprint(data[\"body\"])\n",
