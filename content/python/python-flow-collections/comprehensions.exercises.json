      "id": "python-flow-collections-comprehensions-c01",
      "type": "code",
      "prompt": "读取以空白分隔的整数序列 values，用列表推导式计算每个数的平方，并按原顺序输出 Python 整数列表，例如 1 2 3 输出 [1, 4, 9]。保留重复项，零和负数有效；空白输入输出 []。任意字段不是整数时不输出内容，退出码为 1。起始代码提供解析后的 values。",
      "starter_code": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    values = [int(word) for word in text.split()]\nexcept ValueError:\n    raise SystemExit(1)\n# 按题面完成本课操作与输出\n",
      "visible_tests": [
        "输入 '1 2 3\\n'，输出 '[1, 4, 9]\\n'，退出码 0。",
        "输入 '4\\n'，输出 '[16]\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    values = [int(word) for word in text.split()]\nexcept ValueError:\n    raise SystemExit(1)\nprint([value * value for value in values])\n",
        "hidden_tests": [
          "核对题面声明的边界、顺序和重复项处理。",
          "输入有效性与退出码按题面约定检查。"
        ],
        "visible_test_cases": [
          {
