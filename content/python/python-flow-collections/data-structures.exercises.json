      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys, json\ntry:\n    groups = json.loads(sys.stdin.read())\nexcept ValueError:\n    raise SystemExit(1)\nif not isinstance(groups, dict) or any(not isinstance(items, list) or any(not isinstance(item, str) for item in items) for items in groups.values()):\n    raise SystemExit(1)\nitems = groups.get(\"beginner\", [])\nprint(len(items))\nfor item in items:\n    print(item)\n",
