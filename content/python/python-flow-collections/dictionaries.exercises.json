      "id": "python-flow-collections-dictionaries-c01",
      "type": "code",
      "prompt": "输入一个 JSON 对象作为 profile，输出 name 字段；字段缺失时输出 unknown。若 name 存在，必须是去掉首尾空白后非空的字符串，输出时去掉首尾空白、保留内部空格。其他字段不参与计算。非法 JSON、非对象、无效 name 不输出内容，退出码为 1。起始代码已解析校验 profile，只需通过字典读取并输出。",
      "starter_code": "import sys, json\ntry:\n    profile = json.loads(sys.stdin.read())\nexcept ValueError:\n    raise SystemExit(1)\nif not isinstance(profile, dict) or (\"name\" in profile and (not isinstance(profile[\"name\"], str) or not profile[\"name\"].strip())):\n    raise SystemExit(1)\n# 按题面完成本课操作与输出\n",
      "visible_tests": [
        "输入 '{\"name\":\"Hard\"}\\n'，输出 'Hard\\n'，退出码 0。",
        "输入 '{}\\n'，输出 'unknown\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys, json\ntry:\n    profile = json.loads(sys.stdin.read())\nexcept ValueError:\n    raise SystemExit(1)\nif not isinstance(profile, dict) or (\"name\" in profile and (not isinstance(profile[\"name\"], str) or not profile[\"name\"].strip())):\n    raise SystemExit(1)\nprint(profile.get(\"name\", \"unknown\").strip())\n",
        "hidden_tests": [
          "核对题面声明的边界、顺序和重复项处理。",
          "输入有效性与退出码按题面约定检查。"
