    {
      "id": "python-modules-io-oop-classes-challenge",
      "type": "challenge",
      "prompt": "输入恰好两行名称，逐行去掉首尾空白、保留内部空格；任一空白行使用默认名称 Learner。定义 Learner(name) 与 greet()，返回 Hello, 后接一个空格和实例名称。先创建两个独立实例，再按输入顺序逐行输出两个 greet() 的返回值，验证第二次初始化没有覆盖第一个实例的名称。缺少行或超过两行时不输出内容，退出码为 1。起始代码已解析 names。",
      "starter_code": "import sys\nlines = sys.stdin.read().splitlines()\nif len(lines) != 2:\n    raise SystemExit(1)\nnames = [line.strip() or \"Learner\" for line in lines]\n# 按题面完成操作并输出\n",
      "visible_tests": [
        "输入 'Hard\\nAda\\n'，输出 'Hello, Hard\\nHello, Ada\\n'，退出码 0。",
        "输入 'One\\nTwo\\n'，输出 'Hello, One\\nHello, Two\\n'，退出码 0。"
