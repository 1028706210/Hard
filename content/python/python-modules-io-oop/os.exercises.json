      "id": "python-modules-io-oop-os-c01",
      "type": "code",
      "prompt": "读取一条教学用相对路径，去掉首尾空白，以 / 分隔目录和文件名。每段只能含 ASCII 字母、数字、点、下划线或连字符；禁止空段、单独的 . 或 ..，因此绝对路径、连续或末尾斜杠、反斜杠与盘符均无效。使用 PurePosixPath 解析并输出最后一段，例如 reports/today.txt 输出 today.txt。无效输入不输出内容，退出码为 1。起始代码已校验，练习只操作路径文本，不创建或访问文件。",
      "starter_code": "import sys\ntext = sys.stdin.read().strip()\nimport re\nfrom pathlib import PurePosixPath\nparts = text.split(\"/\")\nif any(part in (\"\", \".\", \"..\") or re.fullmatch(r\"[A-Za-z0-9_.-]+\", part) is None for part in parts):\n    raise SystemExit(1)\n# 按题面完成操作并输出\n",
      "visible_tests": [
        "输入 'reports/today.txt'，输出 'today.txt\\n'，退出码 0。",
        "输入 'notes/lesson.py'，输出 'lesson.py\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\nimport re\nfrom pathlib import PurePosixPath\nparts = text.split(\"/\")\nif any(part in (\"\", \".\", \"..\") or re.fullmatch(r\"[A-Za-z0-9_.-]+\", part) is None for part in parts):\n    raise SystemExit(1)\npath = PurePosixPath(text)\nprint(path.name)\n",
        "hidden_tests": [
