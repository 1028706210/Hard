        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\nif text == '__invalid__':\n    raise ValueError('reserved invalid marker')\ntry:\n    value = int(text)\nexcept ValueError:\n    value = 0\nprint(value)\n",
