    {
      "id": "python-modules-io-oop-files-c01",
      "type": "code",
      "prompt": "读取全部文本，只删除末尾所有换行符 \\n，保留空格和内部换行。若文本含真正的 NUL 字符（U+0000），不输出内容并以退出码 1 结束；__invalid__ 是普通合法文本。使用 UTF-8 将文本写入当前 Runner 临时工作目录的固定文件 note.txt，再读回并用 print 输出，因此输出末尾额外有一个换行。空文本允许，输出一个换行。不要把输入当作路径，不访问其他目录。起始代码提供读取和 NUL 检查。",
      "starter_code": "import sys\ntext = sys.stdin.read().rstrip(\"\\n\")\nif \"\\x00\" in text:\n    raise SystemExit(1)\n# 按题面完成操作并输出\n",
      "visible_tests": [
        "输入 'ready\\n'，输出 'ready\\n'，退出码 0。",
        "输入 '学习\\n'，输出 '学习\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().rstrip(\"\\n\")\nif \"\\x00\" in text:\n    raise SystemExit(1)\nwith open(\"note.txt\", \"w\", encoding=\"utf-8\") as handle:\n    handle.write(text)\nwith open(\"note.txt\", \"r\", encoding=\"utf-8\") as handle:\n    result = handle.read()\nprint(result)\n",
        "hidden_tests": [
          "验证题面声明的边界与正常结果。",
          "输入有效性和退出码以题面为准。"
        ],
        "visible_test_cases": [
          {
