      "type": "code",
      "prompt": "读取一行文本，仅去掉末尾换行符。按简化规则判断一级标题：必须以 # 和一个空格开头，后面的标题去掉空白后非空，而且整段不含内部换行。输出 True 或 False，所有输入正常结束。不要渲染 HTML；此规则不是完整 CommonMark 解析器。",
      "starter_code": "import sys\ntext = sys.stdin.read().rstrip(\"\\n\")\n# 按题面实现本课操作\n",
      "visible_tests": [
        "输入 '# 今日计划'，输出 'True\\n'，退出码 0。",
        "输入 '## 子标题'，输出 'False\\n'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().rstrip(\"\\n\")\nprint(\"\\n\" not in text and text.startswith(\"# \") and bool(text[2:].strip()))\n",
