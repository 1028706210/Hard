      "type": "code",
      "prompt": "定义保留函数元数据的 announce 装饰器，为输入名称添加 run 前缀。",
      "starter_code": "# 定义 announce 装饰器并调用 task\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import functools\nimport sys\ndef announce(func):\n    @functools.wraps(func)\n    def wrapped(name):\n        return 'run ' + func(name)\n    return wrapped\n@announce\ndef task(name):\n    return name\nname = sys.stdin.read().strip()\nif name == '__invalid__' or not name:\n    raise ValueError('task name required')\nprint(task(name))\n",
        "hidden_tests": [
          "边界输入必须返回主题定义的结果。",
          "无效输入必须进入可预期的失败分支。"
        ],
