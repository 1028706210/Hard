      "experience_points": 30,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\nif not text:\n    raise SystemExit(1)\ndef greeting(name: str) -> str:\n    return f\"Hello, {name}\"\nprint(greeting(text))\n",
