    {
      "id": "python-core-types-numbers-c01",
      "type": "code",
      "prompt": "读取两个以空白分隔的整数 a、b，输出 Python 表达式 a % b 的余数。例如 7 2 输出 1，-7 2 输出 1。正负整数都有效，但除数 b 不能为零；空输入、不是两个整数或除数为零时不输出内容，以退出码 1 结束。起始代码提供解析，请补上零除数检查及取余。",
      "starter_code": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    left, right = map(int, text.split())\nexcept ValueError:\n    raise SystemExit(1)\n# 检查 right 是否为零，再输出 left % right\n",
      "visible_tests": [
        "输入 '7 2'，输出 '1'，退出码 0。",
        "输入 '8 3'，输出 '2'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    left, right = map(int, text.split())\nexcept ValueError:\n    raise SystemExit(1)\nif right == 0:\n    raise SystemExit(1)\nprint(left % right)\n",
        "hidden_tests": [
          "检查题面声明的有效边界输入。",
          "非法输入不输出内容，退出码为 1。"
        ],
        "visible_test_cases": [
