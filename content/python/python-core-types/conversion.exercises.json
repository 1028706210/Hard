      "id": "python-core-types-conversion-c01",
      "type": "code",
      "prompt": "读取标准输入并去掉首尾空白，用 int 将文本转换成整数，输出该整数加 1 的结果。例如输入 12 输出 13，输入 -1 输出 0。接受 int 能解析的整数文本；空输入或不能转换的文本（如 3.5、abc）不输出任何内容，以退出码 1 结束。起始代码提供读取，请完成转换及 ValueError 处理。",
      "starter_code": "import sys\ntext = sys.stdin.read().strip()\n# 尝试 int(text)，失败时退出码为 1；成功时输出加一结果\n",
      "visible_tests": [
        "输入 '12'，输出 '13'，退出码 0。",
        "输入 '4'，输出 '5'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    value = int(text)\nexcept ValueError:\n    raise SystemExit(1)\nprint(value + 1)\n",
