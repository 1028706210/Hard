      "id": "python-foundations-interpreter-c01",
      "type": "code",
      "prompt": "把交互式计算保存为可重复运行的小程序：读取两个以空白分隔的整数并输出它们的和。例如 7 8 输出 15。零和负数有效；空输入、非整数或不是恰好两个数时不输出内容，退出码为 1。起始代码负责读取校验，得到 left 和 right，只需补上求和输出。",
      "starter_code": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    left, right = map(int, text.split())\nexcept ValueError:\n    raise SystemExit(1)\n# 按题面补上结果计算与输出\n",
      "visible_tests": [
        "输入 '7 8'，输出 '15'，退出码 0。",
        "输入 '2 3'，输出 '5'，退出码 0。"
      ],
      "experience_points": 15,
      "private": {
        "reference_solution": "import sys\ntext = sys.stdin.read().strip()\ntry:\n    left, right = map(int, text.split())\nexcept ValueError:\n    raise SystemExit(1)\nprint(left + right)\n",
