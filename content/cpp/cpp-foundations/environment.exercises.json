    {
      "id": "cpp-foundations-environment-c01",
      "type": "code",
      "prompt": "依次读取本机已安装的编译器主版本号 installed 和项目要求的最低主版本号 required；当 installed 不低于 required 时输出 READY，否则输出 UPDATE。",
      "starter_code": "#include <iostream>\n\nint main() {\n    int installed = 0;\n    int required = 0;\n    std::cin >> installed >> required;\n    // 判断工具链是否就绪\n    return 0;\n}\n",
      "visible_tests": [
        "输入 16 和 16 时输出 READY。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\nint main() {\n    int installed = 0;\n    int required = 0;\n    std::cin >> installed >> required;\n    std::cout << (installed >= required ? \"READY\" : \"UPDATE\") << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "已安装版本低于要求时输出 UPDATE。",
          "已安装版本高于要求时输出 READY。"
        ],
        "visible_test_cases": [
          {
            "stdin": "16 16\n",
            "stdout": "READY\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "11 16\n",
            "stdout": "UPDATE\n",
            "exit_code": 0
          },
          {
            "stdin": "20 16\n",
            "stdout": "READY\n",
            "exit_code": 0
          }
        ]
      }
    }
