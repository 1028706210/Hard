    {
      "id": "cpp-foundations-comments-c01",
      "type": "code",
      "prompt": "读取整数 n，在包含至少一条说明用途注释的代码中输出 n 的两倍。代码中必须出现 // 或 /* */ 形式的注释。",
      "starter_code": "#include <iostream>\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    // 在此补充注释与计算\n    return 0;\n}\n",
      "visible_tests": [
        "输入 3 时输出 6。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    // 读取 n 后输出其两倍\n    int doubled = n * 2;\n    std::cout << doubled << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "输入 0 时输出 0。",
          "输入负数时输出对应的负偶数。"
        ],
        "visible_test_cases": [
