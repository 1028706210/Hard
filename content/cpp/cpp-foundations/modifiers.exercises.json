    {
      "id": "cpp-foundations-modifiers-c01",
      "type": "code",
      "prompt": "读取整数 n（可能是负数），将其显式转换为 unsigned int 后输出转换结果（32 位回绕语义）。",
      "starter_code": "#include <iostream>\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    // 转换为 unsigned int 后输出\n    return 0;\n}\n",
      "visible_tests": [
        "输入 5 时输出 5。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    unsigned int wrapped = static_cast<unsigned int>(n);\n    std::cout << wrapped << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "输入 0 时输出 0。",
          "输入 -1 时按 32 位回绕输出 4294967295。"
        ],
        "visible_test_cases": [
          {
            "stdin": "5\n",
            "stdout": "5\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "0\n",
            "stdout": "0\n",
            "exit_code": 0
          },
          {
            "stdin": "-1\n",
            "stdout": "4294967295\n",
            "exit_code": 0
          }
        ]
      }
    }
  ]
