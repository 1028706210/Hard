      "id": "cpp-foundations-modifiers-k01",
      "type": "knowledge",
      "prompt": "unsigned 修饰符对整数类型的作用是？",
      "choices": [
        {
          "id": "a",
          "text": "把类型改为浮点"
        },
        {
          "id": "b",
          "text": "使变量不可修改"
        },
        {
          "id": "c",
          "text": "去掉符号位，正数上限翻倍但不能表示负数"
        }
      ],
      "experience_points": 5,
      "private": {
        "reference_answer": "c"
      }
    },
    {
      "id": "cpp-foundations-modifiers-k02",
      "type": "knowledge",
      "prompt": "在 32 位 unsigned int 下，把 -1 赋值后的结果是？",
