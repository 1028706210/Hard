    {
      "id": "cpp-foundations-basic-syntax-c01",
      "type": "code",
      "prompt": "读取整数 count，声明字符串变量 language 保存 \"cpp\"、字符变量 marker 保存 '#'，按 cpp:#<count> 格式输出。",
      "starter_code": "#include <iostream>\n#include <string>\n\nint main() {\n    int count = 0;\n    std::cin >> count;\n    // 声明 language 与 marker，并按格式输出\n    return 0;\n}\n",
      "visible_tests": [
        "输入 3 时输出 cpp:#3。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n#include <string>\n\nint main() {\n    int count = 0;\n    std::cin >> count;\n    std::string language = \"cpp\";\n    char marker = '#';\n    std::cout << language << ':' << marker << count << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "零值保持数字含义输出 cpp:#0。",
          "多位整数完整输出。"
        ],
        "visible_test_cases": [
