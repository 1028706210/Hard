    {
      "id": "cpp-foundations-loops-c01",
      "type": "code",
      "prompt": "读取非负整数 n，使用有限循环累计 1 到 n 的整数和，并以 long long 类型输出结果。",
      "starter_code": "#include <iostream>\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    long long total = 0;\n    // 使用有限循环累计 1..n\n    return 0;\n}\n",
      "visible_tests": [
        "输入 4 时输出 10。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    long long total = 0;\n    for (int i = 1; i <= n; i++) {\n        total += i;\n    }\n    std::cout << total << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "n 为 0 时循环不执行且输出 0。",
          "n 为 100 时按等差求和输出 5050。"
        ],
        "visible_test_cases": [
          {
            "stdin": "4\n",
            "stdout": "10\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "0\n",
            "stdout": "0\n",
            "exit_code": 0
          },
          {
            "stdin": "100\n",
            "stdout": "5050\n",
            "exit_code": 0
          }
        ]
      }
    }
