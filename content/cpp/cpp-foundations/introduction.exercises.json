      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\nint main() {\n    int a = 0;\n    int b = 0;\n    std::cin >> a >> b;\n    std::cout << a + b << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "负数参与加法时结果正确。",
          "较大整数相加仍在 int 范围内并正确输出。"
        ],
        "visible_test_cases": [
