    {
      "id": "cpp-foundations-variables-c01",
      "type": "code",
      "prompt": "读取同一行上的两个整数 width 与 height，用变量保存二者并输出其乘积（面积）。",
      "starter_code": "#include <iostream>\n\nint main() {\n    int width = 0;\n    int height = 0;\n    std::cin >> width >> height;\n    // 用变量保存并输出面积\n    return 0;\n}\n",
      "visible_tests": [
        "输入 3 4 时输出 12。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\nint main() {\n    int width = 0;\n    int height = 0;\n    std::cin >> width >> height;\n    int area = width * height;\n    std::cout << area << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "任一边为 0 时输出 0。",
          "较大边长按 int 乘法正确输出。"
        ],
        "visible_test_cases": [
          {
            "stdin": "3 4\n",
            "stdout": "12\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "5 5\n",
            "stdout": "25\n",
            "exit_code": 0
          },
          {
            "stdin": "0 9\n",
            "stdout": "0\n",
            "exit_code": 0
          }
        ]
      }
    }
  ]
