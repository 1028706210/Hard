    {
      "id": "cpp-advanced-namespaces-c01",
      "type": "code",
      "prompt": "定义命名空间 calc，其中函数 transform(v) 返回 v*2+1。读取整数 n，通过 calc::transform 调用并输出结果。",
      "starter_code": "#include <iostream>\n\n// 定义命名空间 calc 与 transform\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    // 经命名空间限定调用并输出\n    return 0;\n}\n",
      "visible_tests": [
        "输入 3 时输出 7。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\nnamespace calc {\nint transform(int value) {\n    return value * 2 + 1;\n}\n}\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    std::cout << calc::transform(n) << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "零输入按公式输出 1。",
          "负数输入保持符号语义。"
        ],
        "visible_test_cases": [
          {
            "stdin": "3\n",
            "stdout": "7\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "0\n",
            "stdout": "1\n",
            "exit_code": 0
          },
          {
            "stdin": "-2\n",
            "stdout": "-3\n",
            "exit_code": 0
          }
        ]
