    {
      "id": "cpp-advanced-exceptions-c01",
      "type": "code",
      "prompt": "读取一整行文本，用 std::stoi 尝试解析为整数：成功时输出该数的两倍，解析抛出异常时捕获并输出 error。",
      "starter_code": "#include <iostream>\n#include <string>\n\nint main() {\n    std::string line;\n    std::getline(std::cin, line);\n    // 解析成功输出两倍，失败输出 error\n    return 0;\n}\n",
      "visible_tests": [
        "输入 21 时输出 42。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n#include <string>\n\nint main() {\n    std::string line;\n    std::getline(std::cin, line);\n    try {\n        int value = std::stoi(line);\n        std::cout << value * 2 << std::endl;\n    } catch (const std::exception& error) {\n        std::cout << \"error\" << std::endl;\n    }\n    return 0;\n}\n",
        "hidden_tests": [
          "非整数文本输出 error。",
          "负数解析成功输出对应负偶数。"
        ],
        "visible_test_cases": [
          {
            "stdin": "21\n",
            "stdout": "42\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "abc\n",
            "stdout": "error\n",
            "exit_code": 0
          },
          {
            "stdin": "-5\n",
            "stdout": "-10\n",
            "exit_code": 0
          }
        ]
      }
    }
