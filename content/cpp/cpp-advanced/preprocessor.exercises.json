    {
      "id": "cpp-advanced-preprocessor-c01",
      "type": "code",
      "prompt": "用 #define 定义常量 STEP 为 5，读取整数 n，输出 n + STEP 的值。",
      "starter_code": "#include <iostream>\n\n// 用 #define 定义 STEP 为 5\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    // 输出 n + STEP\n    return 0;\n}\n",
      "visible_tests": [
        "输入 1 时输出 6。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\n#define STEP 5\n\nint main() {\n    int n = 0;\n    std::cin >> n;\n    std::cout << n + STEP << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "零输入输出常量本身。",
          "负数输入按加法语义输出。"
        ],
        "visible_test_cases": [
          {
            "stdin": "1\n",
            "stdout": "6\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "0\n",
            "stdout": "5\n",
            "exit_code": 0
          },
          {
            "stdin": "-10\n",
            "stdout": "-5\n",
            "exit_code": 0
          }
        ]
      }
    }
