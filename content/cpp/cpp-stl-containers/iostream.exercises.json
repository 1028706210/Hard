      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n#include <string>\n\nint main() {\n    std::string line;\n    if (!std::getline(std::cin, line)) return 1;\n    if (line.size() > 1000) return 1;\n    std::cout << line.size() << std::endl;\n    return 0;\n}\n",
