      "id": "cpp-stl-containers-vector-c01",
      "type": "code",
      "prompt": "读取整数 n（合同范围 1..1000，含两端）与 n 个整数（每个合同范围 -10000..10000，含两端），全部 push_back 进 vector 后输出三行：元素个数、首元素、尾元素。n 或任一值无法解析或越界时不输出内容并以非零退出码结束。",
      "starter_code": "#include <iostream>\n#include <vector>\n\nint main() {\n    // 读取 n 与 n 个整数，输出个数、首元素、尾元素\n    return 0;\n}\n",
      "visible_tests": [
        "输入 n=3 与 10 20 30 时输出 3、10、30 三行。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n#include <vector>\n\nint main() {\n    int n = 0;\n    if (!(std::cin >> n)) return 1;\n    if (n < 1 || n > 1000) return 1;\n    std::vector<int> values;\n    for (int i = 0; i < n; i++) {\n        int value = 0;\n        if (!(std::cin >> value)) return 1;\n        if (value < -10000 || value > 10000) return 1;\n        values.push_back(value);\n    }\n    std::cout << values.size() << \"\\n\";\n    std::cout << values.front() << \"\\n\";\n    std::cout << values.back() << \"\\n\";\n    return 0;\n}\n",
        "hidden_tests": [
          "n=1 时首尾相同。",
          "含负数时首尾保留符号。"
        ],
        "visible_test_cases": [
          {
