      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <array>\n#include <iostream>\n\nint main() {\n    std::array<int, 5> values = {};\n    for (int i = 0; i < 5; i++) {\n        if (!(std::cin >> values[i])) return 1;\n        if (values[i] < -1000 || values[i] > 1000) return 1;\n    }\n    for (int i = 4; i >= 0; i--) {\n        std::cout << values[i] << \"\\n\";\n    }\n    return 0;\n}\n",
        "hidden_tests": [
          "含负数时逆序保留符号。",
