      "id": "cpp-stl-containers-iomanip-c01",
      "type": "code",
      "prompt": "读取一个浮点数 x 与整数宽度 w（合同范围：x 绝对值不超过 1000，w 3..20，含两端），用 fixed 与 setprecision(2) 保留两位小数，再用 setw(w) 右对齐输出该数（宽度不足左侧补空格）并换行。输入无法解析或越界时不输出内容并以非零退出码结束。",
      "starter_code": "#include <iomanip>\n#include <iostream>\n\nint main() {\n    // 读取 x 与 w，按宽度和两位小数输出\n    return 0;\n}\n",
      "visible_tests": [
        "输入 3.14159 与 8 时输出四个空格加 3.14（即「    3.14」）。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iomanip>\n#include <iostream>\n\nint main() {\n    double x = 0.0;\n    int w = 0;\n    if (!(std::cin >> x >> w)) return 1;\n    if (x < -1000 || x > 1000) return 1;\n    if (w < 3 || w > 20) return 1;\n    std::cout << std::setw(w) << std::fixed << std::setprecision(2) << x << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "宽度刚好等于内容长度时不补空格。",
          "负数按两位小数右对齐输出。"
        ],
        "visible_test_cases": [
          {
            "stdin": "3.14159 8\n",
            "stdout": "    3.14\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
