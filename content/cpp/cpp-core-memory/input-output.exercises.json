    {
      "id": "cpp-core-memory-input-output-c01",
      "type": "code",
      "prompt": "读取整数 n 与宽度 w（1 ≤ w ≤ 20），使用 std::setw(w) 右对齐输出 n（不足宽度左侧补空格，超出宽度原样输出）。",
      "starter_code": "#include <iomanip>\n#include <iostream>\n\nint main() {\n    int n = 0;\n    int w = 0;\n    std::cin >> n >> w;\n    // 用 setw 定宽输出\n    return 0;\n}\n",
      "visible_tests": [
        "输入 42 5 时输出三个空格加 42。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iomanip>\n#include <iostream>\n\nint main() {\n    int n = 0;\n    int w = 0;\n    std::cin >> n >> w;\n    std::cout << std::setw(w) << n << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "宽度等于位数时原样输出。",
          "负数按总宽度（含负号）右对齐。"
        ],
        "visible_test_cases": [
          {
            "stdin": "42 5\n",
            "stdout": "   42\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "123 3\n",
            "stdout": "123\n",
            "exit_code": 0
          },
          {
            "stdin": "-7 4\n",
            "stdout": "  -7\n",
            "exit_code": 0
          }
        ]
      }
    }
