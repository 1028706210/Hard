    {
      "id": "cpp-core-memory-strings-c01",
      "type": "code",
      "prompt": "用 std::getline 读取一整行文本（可能含空格，也可能为空行），输出其反转后的字符串。",
      "starter_code": "#include <iostream>\n#include <string>\n\nint main() {\n    std::string line;\n    std::getline(std::cin, line);\n    // 输出反转结果\n    return 0;\n}\n",
      "visible_tests": [
        "输入 abc 时输出 cba。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n#include <string>\n\nint main() {\n    std::string line;\n    std::getline(std::cin, line);\n    std::string reversed;\n    for (std::size_t i = line.size(); i > 0; i--) {\n        reversed += line[i - 1];\n    }\n    std::cout << reversed << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "单字符输入反转后不变。",
          "含空格文本整行反转（空格位置随之移动）。"
        ],
        "visible_test_cases": [
          {
            "stdin": "abc\n",
            "stdout": "cba\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "a\n",
            "stdout": "a\n",
            "exit_code": 0
          },
          {
            "stdin": "ab cd\n",
            "stdout": "dc ba\n",
            "exit_code": 0
          }
        ]
      }
    }
  ]
}
