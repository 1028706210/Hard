      "id": "cpp-core-memory-arrays-c01",
      "type": "code",
      "prompt": "读取同一行上的 5 个整数存入定长数组，遍历数组输出所有元素之和。",
      "starter_code": "#include <iostream>\n\nint main() {\n    int values[5] = {0};\n    // 读取 5 个整数并求和输出\n    return 0;\n}\n",
      "visible_tests": [
        "输入 1 2 3 4 5 时输出 15。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\nint main() {\n    int values[5] = {0};\n    for (int i = 0; i < 5; i++) {\n        std::cin >> values[i];\n    }\n    int total = 0;\n    for (int i = 0; i < 5; i++) {\n        total += values[i];\n    }\n    std::cout << total << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "全 0 输入输出 0。",
          "含负数时按有符号求和输出。"
        ],
        "visible_test_cases": [
          {
            "stdin": "1 2 3 4 5\n",
            "stdout": "15\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "0 0 0 0 0\n",
            "stdout": "0\n",
            "exit_code": 0
          },
          {
            "stdin": "-1 5 -2 8 3\n",
            "stdout": "13\n",
            "exit_code": 0
          }
        ]
      }
