    {
      "id": "cpp-core-memory-pointers-c01",
      "type": "code",
      "prompt": "读取两个整数 a 与 b，编写以指针为参数的 swap(int*, int*) 函数交换二者，输出交换后的结果（空格分隔）。",
      "starter_code": "#include <iostream>\n\n// 定义以指针为参数的 swap 函数\n\nint main() {\n    int a = 0;\n    int b = 0;\n    std::cin >> a >> b;\n    // 通过指针交换并输出\n    return 0;\n}\n",
      "visible_tests": [
        "输入 3 7 时输出 7 3。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <iostream>\n\nvoid swap(int* a, int* b) {\n    int temp = *a;\n    *a = *b;\n    *b = temp;\n}\n\nint main() {\n    int a = 0;\n    int b = 0;\n    std::cin >> a >> b;\n    swap(&a, &b);\n    std::cout << a << \" \" << b << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "两个 0 交换后不变。",
          "正负混合输入按交换语义输出。"
        ],
        "visible_test_cases": [
          {
            "stdin": "3 7\n",
            "stdout": "7 3\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "0 0\n",
            "stdout": "0 0\n",
            "exit_code": 0
          },
          {
            "stdin": "-1 5\n",
            "stdout": "5 -1\n",
            "exit_code": 0
          }
        ]
      }
    }
