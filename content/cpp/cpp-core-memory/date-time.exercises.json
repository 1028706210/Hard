    {
      "id": "cpp-core-memory-date-time-c01",
      "type": "code",
      "prompt": "读取非负整数秒数 total，使用 <chrono> 的 duration 与 duration_cast 换算并以 h:m:s 格式输出（如 3661 输出 1:1:1）。",
      "starter_code": "#include <chrono>\n#include <iostream>\n\nint main() {\n    int total = 0;\n    std::cin >> total;\n    // 用 chrono 换算并输出 h:m:s\n    return 0;\n}\n",
      "visible_tests": [
        "输入 3661 时输出 1:1:1。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <chrono>\n#include <iostream>\n\nint main() {\n    int total = 0;\n    std::cin >> total;\n    std::chrono::seconds duration(total);\n    auto hours = std::chrono::duration_cast<std::chrono::hours>(duration);\n    auto minutes = std::chrono::duration_cast<std::chrono::minutes>(duration % std::chrono::hours(1));\n    auto seconds = duration % std::chrono::minutes(1);\n    std::cout << hours.count() << \":\" << minutes.count() << \":\" << seconds.count() << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "输入 0 时输出 0:0:0。",
          "整小时数换算分秒为 0。"
        ],
        "visible_test_cases": [
          {
            "stdin": "3661\n",
            "stdout": "1:1:1\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "0\n",
            "stdout": "0:0:0\n",
            "exit_code": 0
          },
          {
            "stdin": "7200\n",
            "stdout": "2:0:0\n",
            "exit_code": 0
          }
        ]
