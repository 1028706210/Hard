    {
      "id": "cpp-algorithms-concurrency-chrono-c01",
      "type": "code",
      "prompt": "读取整数毫秒数 m（合同范围 0..2000000000，含两端），构造 std::chrono::milliseconds(m) 后用 duration_cast 换算为秒，输出整秒数（long long）。m 无法解析或越界时不输出内容并以非零退出码结束。",
      "starter_code": "#include <chrono>\n#include <iostream>\n\nint main() {\n    // 读取毫秒数 m，duration_cast 换算输出整秒\n    return 0;\n}\n",
      "visible_tests": [
        "输入 1500 时输出 1。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "#include <chrono>\n#include <iostream>\n\nint main() {\n    long long m = 0;\n    if (!(std::cin >> m)) return 1;\n    if (m < 0 || m > 2000000000LL) return 1;\n    std::chrono::milliseconds span(m);\n    auto whole_seconds = std::chrono::duration_cast<std::chrono::seconds>(span);\n    std::cout << whole_seconds.count() << std::endl;\n    return 0;\n}\n",
        "hidden_tests": [
          "999 毫秒截断为 0 秒。",
          "1000 毫秒恰好 1 秒。"
        ],
        "visible_test_cases": [
          {
            "stdin": "1500\n",
            "stdout": "1\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "999\n",
            "stdout": "0\n",
            "exit_code": 0
          },
          {
            "stdin": "1000\n",
            "stdout": "1\n",
            "exit_code": 0
          }
        ]
      }
    }
