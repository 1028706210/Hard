      "private": {
        "reference_solution": "import java.nio.charset.StandardCharsets;\n\nenum Color {\n    RED(1), GREEN(2), BLUE(3);\n    final int v;\n    Color(int v) { this.v = v; }\n}\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();\n        if (input.equals(\"__invalid__\")) System.exit(1);\n        System.out.println(Color.valueOf(input).v);\n    }\n}\n",
