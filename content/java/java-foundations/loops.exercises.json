    {
      "id": "java-foundations-loops-c01",
      "type": "code",
      "prompt": "读取一个整数 n（0 到 1000），用循环计算 1 到 n 的整数和并输出。n 为 0 时输出 0。空输入、非整数、多个值或超出范围时不输出结果，以退出码 1 结束。",
      "starter_code": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner input = new Scanner(System.in);\n        // 校验输入，用循环累加，再输出结果\n    }\n}\n",
      "visible_tests": [
        "输入 4 时输出 10。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner input = new Scanner(System.in);\n        if (!input.hasNextInt()) System.exit(1);\n        int n = input.nextInt();\n        if (n < 0 || n > 1000 || input.hasNext()) System.exit(1);\n        int total = 0;\n        for (int i = 1; i <= n; i++) total += i;\n        System.out.println(total);\n    }\n}\n",
        "hidden_tests": [
          "零次迭代输出 0。",
          "较大合法输入仍逐项求和。",
          "非法输入以非零状态结束。"
        ],
        "visible_test_cases": [
          {
