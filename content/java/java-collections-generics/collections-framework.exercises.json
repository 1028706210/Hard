      "prompt": "从标准输入读取逗号分隔字符串，用 TreeSet 去重排序后空格分隔输出。",
      "starter_code": "public class Main {\n    public static void main(String[] args) throws Exception {\n        // TODO\n    }\n}\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "import java.nio.charset.StandardCharsets;\nimport java.util.TreeSet;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();\n        if (input.equals(\"__invalid__\")) System.exit(1);\n        TreeSet<String> set = new TreeSet<>();\n        for (String p : input.split(\",\")) set.add(p.trim());\n        StringBuilder sb = new StringBuilder();\n        for (String s : set) { if (sb.length() > 0) sb.append(\" \"); sb.append(s); }\n        System.out.println(sb);\n    }\n}\n",
        "hidden_tests": [
          "边界输入必须返回题目定义的结果。",
          "非法输入必须以非零状态结束。"
        ],
        "visible_test_cases": [
          {
            "stdin": "b,a,c\n",
            "stdout": "a b c\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "x,x,y\n",
            "stdout": "x y\n",
            "exit_code": 0
          },
          {
