        "reference_solution": "import java.nio.charset.StandardCharsets;\nimport java.util.HashMap;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();\n        if (input.equals(\"__invalid__\")) System.exit(1);\n        HashMap<String, Integer> map = new HashMap<>();\n        for (String p : input.split(\",\")) map.put(p.trim(), 1);\n        System.out.println(map.size());\n    }\n}\n",
