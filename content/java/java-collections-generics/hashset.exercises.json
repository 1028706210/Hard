      "experience_points": 20,
      "private": {
        "reference_solution": "import java.nio.charset.StandardCharsets;\nimport java.util.HashSet;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();\n        if (input.equals(\"__invalid__\")) System.exit(1);\n        HashSet<String> set = new HashSet<>();\n        for (String p : input.split(\",\")) set.add(p.trim());\n        System.out.println(set.size());\n    }\n}\n",
        "hidden_tests": [
          "边界输入必须返回题目定义的结果。",
          "非法输入必须以非零状态结束。"
