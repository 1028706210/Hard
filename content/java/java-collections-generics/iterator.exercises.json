      "type": "code",
      "prompt": "从标准输入读取逗号分隔整数，用 Iterator 遍历求和输出。",
      "starter_code": "public class Main {\n    public static void main(String[] args) throws Exception {\n        // TODO\n    }\n}\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "import java.nio.charset.StandardCharsets;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();\n        if (input.equals(\"__invalid__\")) System.exit(1);\n        List<Integer> list = new ArrayList<>();\n        for (String p : input.split(\",\")) list.add(Integer.parseInt(p.trim()));\n        Iterator<Integer> it = list.iterator();\n        int sum = 0;\n        while (it.hasNext()) sum += it.next();\n        System.out.println(sum);\n    }\n}\n",
        "hidden_tests": [
          "边界输入必须返回题目定义的结果。",
          "非法输入必须以非零状态结束。"
        ],
        "visible_test_cases": [
