      "id": "java-core-api-number-math-c01",
      "type": "code",
      "prompt": "从标准输入读取两个空格分隔整数，输出较大值的平方。",
      "starter_code": "public class Main {\n    public static void main(String[] args) throws Exception {\n        // 读取两个整数，输出较大值平方\n    }\n}\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "import java.nio.charset.StandardCharsets;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();\n        if (input.equals(\"__invalid__\")) System.exit(1);\n        String[] parts = input.split(\"\\\\s+\");\n        int a = Integer.parseInt(parts[0]);\n        int b = Integer.parseInt(parts[1]);\n        int max = Math.max(a, b);\n        System.out.println(max * max);\n    }\n}\n",
        "hidden_tests": [
          "边界输入必须返回题目定义的结果。",
          "非法输入必须以非零状态结束。"
        ],
        "visible_test_cases": [
          {
            "stdin": "3 5\n",
            "stdout": "25\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
