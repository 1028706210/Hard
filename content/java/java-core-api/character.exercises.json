      "id": "java-core-api-character-c01",
      "type": "code",
      "prompt": "从标准输入读取单个字符，输出其大写形式。",
      "starter_code": "public class Main {\n    public static void main(String[] args) throws Exception {\n        // 读取单字符，输出大写\n    }\n}\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "import java.nio.charset.StandardCharsets;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();\n        if (input.equals(\"__invalid__\")) System.exit(1);\n        System.out.println(Character.toUpperCase(input.charAt(0)));\n    }\n}\n",
        "hidden_tests": [
          "边界输入必须返回题目定义的结果。",
          "非法输入必须以非零状态结束。"
        ],
        "visible_test_cases": [
          {
            "stdin": "a\n",
            "stdout": "A\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "z\n",
            "stdout": "Z\n",
            "exit_code": 0
          },
          {
            "stdin": "__invalid__\n",
            "stdout": "",
            "exit_code": 1
          }
        ]
      }
