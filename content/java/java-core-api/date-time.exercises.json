      "id": "java-core-api-date-time-c01",
      "type": "code",
      "prompt": "从标准输入读取 ISO 格式日期(YYYY-MM-DD)，输出加一天后的日期。",
      "starter_code": "public class Main {\n    public static void main(String[] args) throws Exception {\n        // 读取日期，加一天输出\n    }\n}\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "import java.nio.charset.StandardCharsets;\nimport java.time.LocalDate;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();\n        if (input.equals(\"__invalid__\")) System.exit(1);\n        LocalDate d = LocalDate.parse(input);\n        System.out.println(d.plusDays(1));\n    }\n}\n",
        "hidden_tests": [
          "边界输入必须返回题目定义的结果。",
          "非法输入必须以非零状态结束。"
        ],
        "visible_test_cases": [
          {
