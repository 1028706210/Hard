    {
      "id": "java-core-api-regex-c01",
      "type": "code",
      "prompt": "从标准输入读取一行文本，如果匹配 [a-z]+@[a-z]+\\\\.[a-z]+ 格式输出 YES，否则输出 NO。",
      "starter_code": "public class Main {\n    public static void main(String[] args) throws Exception {\n        // 读取文本，判断邮箱格式\n    }\n}\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "import java.nio.charset.StandardCharsets;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();\n        if (input.equals(\"__invalid__\")) System.exit(1);\n        boolean match = input.matches(\"[a-z]+@[a-z]+\\\\.[a-z]+\");\n        System.out.println(match ? \"YES\" : \"NO\");\n    }\n}\n",
        "hidden_tests": [
          "边界输入必须返回题目定义的结果。",
          "非法输入必须以非零状态结束。"
        ],
        "visible_test_cases": [
          {
            "stdin": "test@example.com\n",
            "stdout": "YES\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "nope\n",
            "stdout": "NO\n",
            "exit_code": 0
          },
          {
            "stdin": "__invalid__\n",
            "stdout": "",
            "exit_code": 1
          }
        ]
      }
    }
