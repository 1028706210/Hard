      "id": "java-core-api-stringbuffer-c01",
      "type": "code",
      "prompt": "从标准输入读取两行文本，用空格连接后输出。",
      "starter_code": "public class Main {\n    public static void main(String[] args) throws Exception {\n        // 读取两行，空格连接输出\n    }\n}\n",
      "visible_tests": [
        "普通输入应完成本题指定的核心操作。"
      ],
      "experience_points": 20,
      "private": {
        "reference_solution": "import java.nio.charset.StandardCharsets;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        String input = new String(System.in.readAllBytes(), StandardCharsets.UTF_8);\n        if (input.trim().equals(\"__invalid__\")) System.exit(1);\n        String[] lines = input.trim().split(\"\\\\R\");\n        if (lines.length < 2) System.exit(1);\n        StringBuffer sb = new StringBuffer();\n        sb.append(lines[0]).append(\" \").append(lines[1]);\n        System.out.println(sb);\n    }\n}\n",
        "hidden_tests": [
          "边界输入必须返回题目定义的结果。",
          "非法输入必须以非零状态结束。"
        ],
        "visible_test_cases": [
          {
            "stdin": "hello\nworld\n",
            "stdout": "hello world\n",
            "exit_code": 0
          }
        ],
        "hidden_test_cases": [
          {
            "stdin": "a\nb\n",
            "stdout": "a b\n",
            "exit_code": 0
          },
          {
            "stdin": "__invalid__\n",
            "stdout": "",
            "exit_code": 1
          }
        ]
      }
    }
