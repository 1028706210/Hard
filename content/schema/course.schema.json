{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["language", "title", "growth", "placement_tests", "modules"],
  "properties": {
    "language": {"enum": ["python", "java", "csharp", "cpp"]},
    "title": {"type": "string", "minLength": 1},
    "growth": {
      "type": "object",
      "required": ["review_milestone_points", "badge_points"],
      "properties": {
        "review_milestone_points": {"type": "integer", "minimum": 0, "maximum": 1000},
        "badge_points": {
          "type": "object",
          "minProperties": 3,
          "required": ["first_lesson", "first_module_mastery", "seven_day_streak"],
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1000}
        }
      },
      "additionalProperties": false
    },
    "placement_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "module_id", "question_ids", "passing_score"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "module_id": {"type": "string", "minLength": 1},
          "question_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "passing_score": {"const": 85}
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "prerequisites", "source_coverage", "lessons"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "source_coverage": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "lesson_id"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "lesson_id": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "path"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
