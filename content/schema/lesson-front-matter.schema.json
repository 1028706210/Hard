{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "concepts",
    "objectives",
    "prerequisites",
    "difficulty",
    "experience_points",
    "source_url",
    "source_snapshot_date"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "concepts": {"type": "array", "items": {"type": "string"}},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "experience_points": {"type": "integer", "minimum": 0, "maximum": 1000},
    "code_exercise_exception_reason": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "source_snapshot_date": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
